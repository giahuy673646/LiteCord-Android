<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_dark_bg">

    <!-- Background content -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/gradient_pattern" />

    <!-- Liquid Glass Container -->
    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/glassContainer"
        android:layout_width="320dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        app:cornerRadius="999dp"
        app:glassMaterial="regular"
        app:refractionHeight="160dp"
        app:bevelWidth="48dp"
        app:dispersionStrength="0.12"
        app:sensorHighlight="true"
        app:adaptiveTint="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to LiteCord"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Privacy-First Chat"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

        </LinearLayout>

    </com.example.liquidglass.LiquidGlassView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="24dp">

        <com.example.liquidglass.LiquidGlassButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Login"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp"
            app:adaptiveTint="true" />

        <com.example.liquidglass.LiquidGlassButton
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Create Account"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp"
            app:adaptiveTint="true" />

    </LinearLayout>

</FrameLayout>
